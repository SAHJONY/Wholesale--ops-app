DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/wholesale_ops
SCHEMA_MODE=strict
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Bland.ai is the exclusive SAHJONY phone provider. SMS remains disabled.
# Store the raw Bland key only: no quotes and no "Bearer " prefix.
BLAND_AI_API_KEY=
# Canonical signed-webhook secret used by the existing voice webhook stack.
BLAND_AI_WEBHOOK_SECRET=
# Optional legacy alias accepted by the newer Bland Phone OS during migration.
BLAND_WEBHOOK_SECRET=
# Only needed if Bland's signature does not arrive in one of the conventional
# headers (x-webhook-signature, x-bland-signature, x-signature, signature).
BLAND_AI_WEBHOOK_SIGNATURE_HEADER=
# Workspace that owns inbound calls. The newer phone OS also accepts
# BLAND_DEFAULT_ORGANIZATION_ID as an alias; keep this canonical value populated.
BLAND_INBOUND_ORGANIZATION_ID=1
BLAND_DEFAULT_ORGANIZATION_ID=1
# Primary Bland business/caller-ID number, E.164, no quotes.
BLAND_DEFAULT_FROM_NUMBER=
# Optional explicit alias for the same business number used by the new Phone OS.
BLAND_BUSINESS_PHONE_NUMBER=
# Every Bland number that accepts inbound calls, comma-separated.
BLAND_INBOUND_NUMBER=
# Production webhook for signed Bland call outcomes.
BLAND_PHONE_WEBHOOK_URL=https://www.sahjony.com/api/backend/bland-phone/webhooks/call
# Voice-only operating switches. Keep SMS disabled in application policy.
BLAND_INBOUND_ENABLED=true
BLAND_AUTONOMOUS_OUTBOUND_ENABLED=true
# Human acquisitions transfer destination, E.164.
VOICE_HUMAN_TRANSFER_TARGET=
# Bland agent identifiers.
BLAND_INBOUND_AGENT_ID=
BLAND_SELLER_OUTBOUND_AGENT_ID=
BLAND_BUYER_DISPO_AGENT_ID=
# The reasoning engine. Claude is primary on every analysis.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
CLAUDE_SERVER_SIDE_FALLBACK=true
# Second engine, tried only when Claude is operationally unreachable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Smarty US address verification.
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# Free public market data.
CENSUS_API_KEY=
CENSUS_ACS_YEAR=2023
FHFA_HPI_ZIP5_URL=
FHFA_HPI_METRO_URL=
FHFA_HPI_STATE_URL=
MARKET_DATA_CACHE_DIR=/tmp/wholesale-market-data
MARKET_DATA_TIMEOUT=30

# FEMA flood risk.
FEMA_NFHL_URL=https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer
FEMA_NFHL_ZONE_LAYER=28
OPENFEMA_BASE_URL=https://www.fema.gov/api/open/v2
CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress
FLOOD_DATA_TIMEOUT=30
FLOOD_INSURANCE_CAP_RATE=0.07

# Property data.
ATTOM_API_KEY=
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
SMARTY_LICENSE=
SMARTY_ENRICHMENT_BASE_URL=
PROPERTY_DATA_PROVIDER=

GOOGLE_MAPS_API_KEY=
HUBSPOT_ACCESS_TOKEN=
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
BATCHDATA_MCP_URL=https://mcp.batchdata.com
BATCHDATA_API_TOKEN=
BATCHDATA_API_KEY=
BATCHDATA_SANDBOX_API_KEY=
CENSUS_API_KEY=
ENABLE_AUTONOMOUS_PROPERTY_ACQUISITION=false
AUTONOMOUS_PROPERTY_FEED_URL=
AUTONOMOUS_PROPERTY_FEED_SOURCE=county
AUTONOMOUS_PROPERTY_FEED_TOKEN=

# SAHJONY departmental business email routing.
BUSINESS_EMAIL_DOMAIN=sahjonycapitalllc.com
BUSINESS_EMAIL_DEFAULT=acquisitions@sahjonycapitalllc.com
BUSINESS_EMAIL_REPLY_TO=acquisitions@sahjonycapitalllc.com
BUSINESS_EMAIL_ACQUISITIONS=acquisitions@sahjonycapitalllc.com
BUSINESS_EMAIL_DISPOSITIONS=dispositions@sahjonycapitalllc.com
BUSINESS_EMAIL_TITLE=title@sahjonycapitalllc.com
BUSINESS_EMAIL_UNDERWRITING=underwriting@sahjonycapitalllc.com
BUSINESS_EMAIL_COMPLIANCE=compliance@sahjonycapitalllc.com
BUSINESS_EMAIL_OPERATIONS=operations@sahjonycapitalllc.com
BUSINESS_EMAIL_SUPPORT=support@sahjonycapitalllc.com
BUSINESS_EMAIL_EXECUTIVE=executive@sahjonycapitalllc.com

# Live bidirectional application email transport (Resend).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_DEFAULT_ORGANIZATION_ID=
EMAIL_DOMAIN_VERIFIED=false
EMAIL_INBOUND_VERIFIED=false
