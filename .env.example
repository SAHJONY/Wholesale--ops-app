DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/wholesale_ops
SCHEMA_MODE=strict
# UPSTASH_* and QSTASH_* were removed: nothing in the application reads them.
# The Redis dependency was dropped as unused and the queue was never wired, but
# the variables stayed documented here, so filling them in looked like
# configuring a cache and a job queue and did nothing at all. Background work
# runs through the background_jobs table.
# Bland.ai voice. The application reads BLAND_AI_* -- the shorter BLAND_* names
# are not read anywhere, so setting those leaves every call failing with
# "BLAND_AI_API_KEY is not configured" while the setup checklist looks answered.
BLAND_AI_API_KEY=
# Shared secret for POST /voice/webhooks/bland. Unset means every delivery is
# rejected -- the endpoint is public, so it fails closed rather than open.
BLAND_AI_WEBHOOK_SECRET=
# Only needed if Bland's signature does not arrive in one of the conventional
# headers (x-webhook-signature, x-bland-signature, x-signature, signature). A
# rejected delivery reports the header names it carried, so the first real one
# tells you whether this needs setting.
BLAND_AI_WEBHOOK_SIGNATURE_HEADER=
# The workspace that owns the receiving number. Outbound results resolve from
# the call id, but a genuinely inbound call has no prior record, and without
# this it is rejected rather than filed against a guessed workspace.
BLAND_INBOUND_ORGANIZATION_ID=
# Outbound caller ID, E.164, no quotes. BLAND_DEFAULT_CALLER_ID is an alias
# read only when this is unset -- both name the number calls are placed FROM.
BLAND_DEFAULT_FROM_NUMBER=
# Every number an inbound agent answers on, comma-separated. Separate from the
# caller ID above: putting an inbound number in an outbound variable would make
# it the fallback caller ID. Include the caller ID itself in this list, so a
# returned call reaches an agent -- 47 CFR 64.1601(e) wants a caller ID that can
# be dialled back to say stop.
BLAND_INBOUND_NUMBER=
BLAND_INBOUND_AGENT_ID=
BLAND_SELLER_OUTBOUND_AGENT_ID=
BLAND_BUYER_DISPO_AGENT_ID=
# The reasoning engine. Claude is primary on every analysis.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
CLAUDE_SERVER_SIDE_FALLBACK=true
# Second engine, tried only when Claude is operationally unreachable, so a
# provider outage degrades to a different model rather than straight to
# rule-based analysis. A refusal is never retried here -- that is a decision,
# not a failure. Leaving these unset is valid; the chain is just shorter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Free public market data (no API key required for either source).
# CENSUS_API_KEY is optional and only raises the daily quota.
CENSUS_API_KEY=
CENSUS_ACS_YEAR=2023
# FHFA reorganised its site in 2024. If verify_market_data.py reports schema
# drift or a 404, point these at the current dataset URLs.
FHFA_HPI_ZIP5_URL=
FHFA_HPI_METRO_URL=
FHFA_HPI_STATE_URL=
MARKET_DATA_CACHE_DIR=/tmp/wholesale-market-data
MARKET_DATA_TIMEOUT=30

# FEMA flood risk (no API key required).
FEMA_NFHL_URL=https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer
FEMA_NFHL_ZONE_LAYER=28
OPENFEMA_BASE_URL=https://www.fema.gov/api/open/v2
CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress
FLOOD_DATA_TIMEOUT=30
# Capitalisation rate used to price a recurring flood premium into value.
# A modelling assumption, not a measurement.
FLOOD_INSURANCE_CAP_RATE=0.07

# Property data. ATTOM and Smarty are alternatives, not both required, and the
# readiness gates accept either. ATTOM wins when both are set unless
# PROPERTY_DATA_PROVIDER names one. PROPSTREAM_API_KEY used to satisfy those
# gates with no adapter behind it, so it no longer counts; setting it alone
# leaves every lookup failing while the checklist looks answered.
ATTOM_API_KEY=
# Smarty needs BOTH values -- one alone is treated as unconfigured rather than
# half-working. These must be a *secret key* pair from the Secret keys tab of the
# API keys page, not an embedded key: the embedded key on that same page is
# browser-scoped and is rejected outright when the request comes from a public
# cloud provider, which is where this backend runs.
#
# Beyond confirming the address is real and returning coordinates, Smarty
# returns the USPS vacancy flag, which stacks as a distress signal. Note that
# lookups are metered per address, so the pair is worth setting even if ATTOM is
# already configured.
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
# Optional. Only needed if the account requires an explicit license, or to point
# at a non-default host.
SMARTY_LICENSE=
SMARTY_ENRICHMENT_BASE_URL=
# Optional. Forces a provider instead of preferring whichever is configured.
PROPERTY_DATA_PROVIDER=

GOOGLE_MAPS_API_KEY=
HUBSPOT_ACCESS_TOKEN=
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
BATCHDATA_MCP_URL=https://mcp.batchdata.com
# Server-side BatchData token used as an MCP Bearer credential. Never expose it to the browser.
BATCHDATA_API_TOKEN=
# Legacy REST adapters may still use these until separately migrated.
BATCHDATA_API_KEY=
BATCHDATA_SANDBOX_API_KEY=
ENABLE_AUTONOMOUS_PROPERTY_ACQUISITION=false
AUTONOMOUS_PROPERTY_FEED_URL=
AUTONOMOUS_PROPERTY_FEED_SOURCE=county
AUTONOMOUS_PROPERTY_FEED_TOKEN=
