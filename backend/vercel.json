{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/scheduled/operations",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/integration-reliability/scheduled",
      "schedule": "15 13 * * *"
    },
    {
      "path": "/jobs/scheduled",
      "schedule": "*/15 * * * *"
    }
  ]
}
